  "upgradeStepCode": "<?php\n/* XF1550-PATCH: new upgrade steps for the 1.5.50 community release. XenForo 1.5.50 community release; see /CHANGELOG-1.5.50.md */\n\nclass XenForo_Install_Upgrade_1055070 extends XenForo_Install_Upgrade_Abstract\n{\n\tpublic function getVersionName()\n\t{\n\t\treturn '1.5.50';\n\t}\n\n\t/**\n\t * Clear the credentials for the social login providers that no longer exist.\n\t *\n\t * Facebook Graph v2.10 was removed by Meta and Google shut down gapi.auth2 in 2023,\n\t * so both login flows fail before they reach the provider. The templates render their\n\t * buttons only when these options are non-empty, so blanking the values retires the\n\t * feature without touching a single template - which is what keeps add-on template\n\t * modifications and custom styles intact.\n\t *\n\t * The option definitions are deliberately left in place so that {$xenOptions.facebookAppId}\n\t * and any add-on reading these options continue to resolve.\n\t *\n\t * Note: the Facebook Like button is unaffected. It force-initialises the SDK through the\n\t * $facebookSdk template container var, independently of the app ID.\n\t */\n\tpublic function step1()\n\t{\n\t\t$this->executeUpgradeQuery(\"\n\t\t\tUPDATE xf_option\n\t\t\tSET option_value = ''\n\t\t\tWHERE option_id IN ('facebookAppId', 'facebookAppSecret', 'googleClientId', 'googleClientSecret')\n\t\t\");\n\t}\n\n\t/**\n\t * Move boards off the retired Microsoft Ajax CDN.\n\t *\n\t * ajax.microsoft.com was decommissioned in 2022; a board still pointed at it serves no\n\t * jQuery at all and is effectively dead in the browser. Fall back to the local copy.\n\t */\n\tpublic function step2()\n\t{\n\t\t$this->executeUpgradeQuery(\"\n\t\t\tUPDATE xf_option\n\t\t\tSET option_value = 'local'\n\t\t\tWHERE option_id = 'jQuerySource'\n\t\t\t\tAND option_value = 'microsoft'\n\t\t\");\n\t}\n\n\t/**\n\t * The 'min' setting for uncompressedJs points at js/xenforo/min/, a directory that has\n\t * never existed in any XenForo distribution, so selecting it 404s every script on the\n\t * board. Send those installs back to the shipped minified files.\n\t */\n\tpublic function step3()\n\t{\n\t\t$this->executeUpgradeQuery(\"\n\t\t\tUPDATE xf_option\n\t\t\tSET option_value = '0'\n\t\t\tWHERE option_id = 'uncompressedJs'\n\t\t\t\tAND option_value = '2'\n\t\t\");\n\t}\n}\n",
